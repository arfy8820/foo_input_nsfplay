From b4de2e9a9b6a253a81f7d2638d18fa44654515f9 Mon Sep 17 00:00:00 2001
From: Colton Hill <redacted@invalid>
Date: Tue, 24 Nov 2026 16:59:21 -0600
Subject: [PATCH 3/5] nsf, nsfplay, ppls: replace static return buffers with
 per-instance storage

NSFPlayer::GetTitleString and NSF::GetPlaylistString returned pointers into
function-static buffers, and both print_time helpers (nsf.cpp, ppls.cpp)
formatted into a static buffer, so concurrent players could overwrite each
other's strings. GetTitleString and GetPlaylistString now return member
buffers (same signatures, same lifetime as the object); print_time writes
into a caller-supplied buffer. GetTitleString also uses snprintf.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xgm/player/nsf/nsf.cpp      | 13 +++++++------
 xgm/player/nsf/nsf.h        |  1 +
 xgm/player/nsf/nsfplay.cpp  |  5 ++---
 xgm/player/nsf/nsfplay.h    |  1 +
 xgm/player/nsf/pls/ppls.cpp | 11 ++++++-----
 5 files changed, 17 insertions(+), 14 deletions(-)

diff --git a/xgm/player/nsf/nsf.cpp b/xgm/player/nsf/nsf.cpp
index 7d0bc70..98d2835 100644
--- a/xgm/player/nsf/nsf.cpp
+++ b/xgm/player/nsf/nsf.cpp
@@ -103,9 +103,9 @@ void sjis_legacy(char* s, const unsigned int length)
     default_loopnum = l;
   }
 
-  static const char *print_time (int time)
+  // buf must hold at least 32 chars
+  static const char *print_time (int time, char *buf)
   {
-    static char buf[32];
     int h, m, s = 0;
 
     if (time < 0)
@@ -128,7 +128,8 @@ void sjis_legacy(char* s, const unsigned int length)
 
   const char *NSF::GetPlaylistString (const char *format, bool b)
   {
-    static char buf[NSF_MAX_PATH + 128];
+    char *buf = playlist_string;
+    char tbuf[32];
     char *p = buf;
 
     const char *t = GetTitleString (format);
@@ -145,17 +146,17 @@ void sjis_legacy(char* s, const unsigned int length)
     if (b)
     {
       if (time_in_ms >= 0)
-        p += sprintf (p, ",%s", print_time (time_in_ms));
+        p += sprintf (p, ",%s", print_time (time_in_ms, tbuf));
       else
         p += sprintf (p, ",");
 
       if (loop_in_ms >= 0)
-        p += sprintf (p, ",%s", print_time (loop_in_ms));
+        p += sprintf (p, ",%s", print_time (loop_in_ms, tbuf));
       else
         p += sprintf (p, ",");
 
       if (fade_in_ms >= 0)
-        p += sprintf (p, ",%s", print_time (fade_in_ms));
+        p += sprintf (p, ",%s", print_time (fade_in_ms, tbuf));
     }
 
     (*p) = '\0';
